# Скопируйте в server/.env и заполните своими значениями

# Куда приходят письма с заявок (обязательно)
NOTIFY_EMAIL=manager@softqod.com

# От кого (если не задано — QODEQ <SMTP_USER>)
# SMTP_FROM="QODEQ <noreply@qodeq.net>"

# SMTP провайдера (обязательно)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@login
SMTP_PASS=your_app_password

# Префикс темы письма (необязательно)
MAIL_SUBJECT_PREFIX=[Сайт] Заявка

# Порт сервера
PORT=3001

# Папка со статикой сайта (по умолчанию — родительская папка)
# SITE_DIR=/var/www/qodeq

# Дублировать в Telegram (необязательно)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Автоответ клиенту на email (true/false)
AUTOREPLY=false
