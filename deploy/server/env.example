# Куда приходят письма с заявок (обязательно)
NOTIFY_EMAIL=you@example.com

# От кого (если не задано — берётся NOTIFY_EMAIL)
# SMTP_FROM="Qodeq <noreply@yourdomain.com>"

# SMTP провайдера (обязательно SMTP_HOST)
# Примеры: smtp.gmail.com, smtp.mailgun.org, smtp.eu.mailgun.org, smtp.yandex.ru
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Для 587 обычно false (STARTTLS). Для 465 — true (SSL); если не задали, для порта 465 включится автоматически.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Если SMTP «висит» или Connection timeout из Docker — попробуйте true
# SMTP_IPV4_FIRST=true

# Временная отладка в логах контейнера: SMTP_DEBUG=true

# Префикс темы письма (необязательно)
# MAIL_SUBJECT_PREFIX=[Сайт] Заявка

PORT=3001

# ---------- база заявок ----------
# По умолчанию /app/data/leads.db (папка ./data на сервере смонтирована в docker-compose.yml)
# LEADS_DB=/app/data/leads.db

# ---------- Telegram-бот заявок ----------
# Токен от @BotFather. Бот должен быть в группе. id группы покажет команда /chatid,
# отправленная в группе (работает, даже пока TELEGRAM_CHAT_ID не задан).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=-100...
# Рабочее время: напоминание «никто не взял» считается только по нему
# WORK_TZ=Europe/Kyiv
# WORK_HOURS=10-19
# WORK_DAYS=1-5            # 1 = понедельник … 7 = воскресенье
# ESCALATE_MIN=15          # через сколько рабочих минут напоминать
# DIGEST_HOUR=10           # утренняя сводка (по умолчанию — начало рабочего дня)
# TG_MENTION=@username     # кого тегнуть в напоминании

# ---------- автоответ клиенту ----------
# AUTOREPLY=true
# AUTOREPLY_FROM="QODEQ <sales@qodeq.net>"   # по умолчанию SMTP_FROM; адрес должен быть разрешён в Gmail (Send mail as)
# CALENDAR_URL=https://...                  # кнопка «Записаться на созвон»; без неё кнопки нет
